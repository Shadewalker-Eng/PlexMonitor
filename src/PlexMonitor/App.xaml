<Application x:Class="PlexMonitor.MonitorApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#E5A00D</Color>
            <Color x:Key="SystemAccentColorLight1">#F5B72F</Color>
            <Color x:Key="SystemAccentColorDark1">#C48406</Color>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#E5A00D"/>
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#E5A00D"/>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#E5A00D"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#E5A00D"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
